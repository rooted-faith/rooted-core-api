ENV=dev
VERSION=v0.1.0

# CORS
CORS_ALLOWED_ORIGINS="*"
CORS_ALLOW_ORIGINS_REGEX=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_CACHE_CONTROL=max-age=86400

# Database
DATABASE_HOST=localhost
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5432
DATABASE_NAME=rooted-portal
DATABASE_SCHEMA=public
SQL_ECHO=

# Redis
REDIS_URL=redis://localhost:6379
REDIS_DB=0
# Logical DB for Redis-backed rate limiters (defaults to 0). Override only when
# Redis exposes additional DBs. A path or ?db= on REDIS_URL can override this.
RATE_LIMITER_REDIS_DB=0
# Optional single trusted client-IP header for HTTP rate limiting (e.g. True-Client-IP).
# Unset/empty = use the connection peer only; X-Forwarded-For is never trusted implicitly.
# Behind a reverse proxy, set this before merge or all clients may share the proxy IP.
# Rollout: set on staging, forge the header and X-Forwarded-For — 429 must still occur;
# confirm a second network is unaffected; then set in production.
TRUSTED_CLIENT_IP_HEADER=

# JWT
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_HASH_SALT=
REFRESH_TOKEN_HASH_PEPPER=

# Resend
## Resend API key; with an empty key every email-mode OTP request fails with 503, in every environment including dev
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
OTP_EMAIL_SENDER=Rooted <account@rootedfaith.app>
## App email OTP
OTP_CODE_EXPIRE_MINUTES=10
OTP_REQUEST_MAX_PER_WINDOW=3
OTP_REQUEST_WINDOW_SECONDS=600
## Test passcode override (ADR 0016, docs/operations/test-passcodes.md): exactly six ASCII digits; empty or malformed uses the backend default.
## Only ENV=dev or ENV=stg with Firebase project rooted-app-dev can ever use it.
OTP_FIXED_CODE=

# Admin Google ID-token sign-in (ADR 0006) — comma-separated Client ID allowlist; empty disables Google admin sign-in
GOOGLE_ADMIN_CLIENT_IDS=

# End-user Google ID-token sign-in (ADR 0008) — comma-separated Client ID allowlist; empty disables Google app sign-in
GOOGLE_APP_CLIENT_IDS=

# Sign in with Apple App IDs / Services IDs accepted by the member API (comma-separated)
APPLE_APP_CLIENT_IDS=

# Push notifications (ADR 0007) — Firebase service-account credential, loaded per environment:
# 1) FIREBASE_CREDENTIALS_PATH (if set) 2) env/firebase_credentials.json 3) /etc/secrets/firebase_credentials.json
FIREBASE_CREDENTIALS_PATH=

# YouVersion Platform API (bible dump and read-time fill). Do not commit a real key.
YVP_APP_KEY=

# Logging
SENSITIVE_PARAMS=password,token,secret,yvp_app_key
